diff --git a/extension/src/background.ts b/extension/src/background.ts
--- a/extension/src/background.ts
+++ b/extension/src/background.ts
@@ -2020,8 +2020,25 @@ const CDP_ALLOWLIST = new Set([
   'Emulation.clearDeviceMetricsOverride',
 ]);
 
+// OneCrew Cloud 修改（2026-10-23）：只给所属适配器会话开放固定站点清理。
+function isOneCrewCloudCleanup(cmd: Command, leaseKey: string): boolean {
+  if (cmd.cdpMethod !== 'Storage.clearDataForOrigin'
+    || getSurfaceFromKey(leaseKey) !== 'adapter'
+    || getSessionFromKey(leaseKey) !== 'onecrew-cloud-session') return false;
+  const params = cmd.cdpParams;
+  if (!params || Object.keys(params).some(key => key !== 'origin' && key !== 'storageTypes')
+    || params.storageTypes !== 'all' || typeof params.origin !== 'string'
+    || !URL.canParse(params.origin)) return false;
+  const url = new URL(params.origin);
+  if (url.origin !== params.origin || url.port
+    || (url.protocol !== 'https:' && url.protocol !== 'http:')) return false;
+  const domains = ['youtube.com', 'google.com', 'tiktok.com', 'instagram.com',
+    'facebook.com', 'x.com', 'twitter.com'];
+  return domains.some(domain => url.hostname === domain || url.hostname.endsWith(`.${domain}`));
+}
+
 async function handleCdp(cmd: Command, leaseKey: string): Promise<Result> {
   if (!cmd.cdpMethod) return { id: cmd.id, ok: false, error: 'Missing cdpMethod' };
-  if (!CDP_ALLOWLIST.has(cmd.cdpMethod)) {
+  if (!CDP_ALLOWLIST.has(cmd.cdpMethod) && !isOneCrewCloudCleanup(cmd, leaseKey)) {
     return { id: cmd.id, ok: false, error: `CDP method not permitted: ${cmd.cdpMethod}` };
   }
