+// OneCrew Cloud：补齐限定原点范围内的域 Cookie 删除，不接收 Cookie 值。
+async function clearOneCrewCloudOriginCookies(origin: string): Promise<void> {
+  const host = new URL(origin).hostname;
+  for (const cookie of await chrome.cookies.getAll({ domain: host })) {
+    const domain = cookie.domain.replace(/^\./, '');
+    if (domain !== host && !domain.endsWith(`.${host}`)) {
+      throw new Error('ONECREW_SESSION_COOKIE_SCOPE_INVALID');
+    }
+    const url = new URL(`${cookie.secure ? 'https' : 'http'}://${domain}`);
+    url.pathname = cookie.path;
+    const removed = await chrome.cookies.remove({
+      url: url.href, name: cookie.name, storeId: cookie.storeId,
+      ...(cookie.partitionKey ? { partitionKey: cookie.partitionKey } : {}),
+    });
+    if (!removed) throw new Error('ONECREW_SESSION_COOKIE_REMOVE_FAILED');
+  }
+}
