# 复制为仓库根目录 .env.cloud；该私有文件不会提交Git。
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APPLICATION_URL=https://cloud.onecrewai.io
ONECREW_CLOUD_DATA_DIRECTORY=/请填写/现有Cloud数据目录
ONECREW_CLOUD_PORT=8788
ONECREW_BROWSER_IMAGE=onecrew-cloud-browser:login-form-20261028
# Mac默认复用本仓库 .scratch 中已有的4B权重与Metal可执行文件。
# 文件放在其他位置时，填写以下绝对路径。
# ONECREW_MODEL_EXECUTABLE=/绝对路径/llama-server
# ONECREW_MODEL_FILE=/绝对路径/Qwen3-4B-Q4_K_M.gguf
