{
  "name": "onecrew-lite-workspace",
  "version": "0.9.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": "26.7.0" },
  "scripts": {
    "onecrew_lite": "pnpm --filter onecrew_lite-app cli",
    "cloud:initialize": "pnpm --filter onecrew_lite-app cloud:initialize",
    "cloud:serve": "pnpm --filter onecrew_lite-app cloud:serve",
    "cloud:start": "node --env-file=.env.cloud onecrew_lite-app/src/cloud/cli.ts serve",
    "cloud:mail:local": "node onecrew_lite-app/src/cli.ts serve --data-dir .scratch/macos-gmail-live --vault .scratch/macos-gmail-live/vault.sqlite --master-key .scratch/macos-gmail-live/masterkey --web-assets onecrew_lite-web/dist --library-web-assets onecrew_lite-library/web/dist",
    "build:tables": "pnpm --filter onecrew_lite_tables build:teable && pnpm --filter onecrew_lite_tables build:server && pnpm --filter onecrew_lite_tables build:web:unified",
    "build:ui": "pnpm --filter onecrew-web build && pnpm --filter onecrew-mcp-ui build",
    "build:candidate": "node onecrew_lite-app/src/packaging/build-candidate.ts",
    "check:contracts": "pnpm --filter onecrew-web contracts:check && pnpm --filter onecrew-mcp-ui contracts:check",
    "check:independence": "node development/check-independence.mts",
    "typecheck": "pnpm --filter onecrew_lite-app typecheck",
    "test:app": "pnpm --filter onecrew_lite-app test",
    "test:tables": "pnpm --filter onecrew_lite_tables test:embedded",
    "test:opencli": "node --test onecrew_lite-opencli/*.test.mjs"
  }
}
